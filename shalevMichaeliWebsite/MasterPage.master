<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage"  %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Shalev Website</title>
                        <asp:ContentPlaceHolder ID="head" runat="server">
                    </asp:ContentPlaceHolder>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500&family=Inter:wght@300;400;500&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #e8f0fe, #f3e8ff);
            color: #1f1f1f;
        }

        .title {
            font-family: 'Google Sans', sans-serif;
            font-size: 26px;
            font-weight: 500;
            width: 100%;
            padding: 20px 40px;
            background: linear-gradient(90deg, #4f8cff, #7b61ff);
            color: white;
            box-sizing: border-box;
            letter-spacing: 0.5px;
        }

        .navbar {
            width: 100%;
            background: #ffffffcc;
            backdrop-filter: blur(10px);
            padding: 10px 30px;
            box-sizing: border-box;
            display: flex;
            gap: 10px;
            border-bottom: 1px solid #e3e3e3;
        }

        .menu {
            padding: 10px 18px;
            border-radius: 20px;
            color: #444746;
            font-weight: 500;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .menu:hover {
            background-color: #e8f0fe;
            color: #1a73e8;
        }

        .main {
            width: 100%;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        .content {
            max-width: 1000px;
            width: 100%;
            padding: 32px;
            background-color: #ffffff;
            border-radius: 24px;
            margin: 20px auto;
            line-height: 1.6;
            border: 1px solid #e3e3e3;
            box-shadow: 0 8px 24px rgba(0,0,0,0.05);
        }

        .content h2 {
            color: #4f8cff;
        }

        img {
            width: 140px;
            height: 90px;
            margin: 10px;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .icons img {
            height: 26px;
            width: 26px;
            padding: 10px;
            border-radius: 0;
            transition: all 0.2s ease;
        }



       
        </style>
</head>

<body>
    <form runat="server" method="post" onsubmit="return checkAll();">
        <table width="100%" height="800px" border="5px" background="lightblue" >

            <tr>
                <td  class="title" height="50px">
                    shalev website
                </td>
            </tr>
                                                                                                        
            <tr>
                <td colspan="2" align="center" class="menu" height="100px">
                    <a href="home.aspx" class="icons"><img src="images/home.png" alt="Home"></a>
                    <a href="signIn.aspx" class="icons"><img src="images/login.png" alt="Sign In"></a>
                    <a href="signUp.aspx" class="icons"><img src="images/signup.png" alt="Sign Up"></a>
    
                    <%%>
                    <%if (Session["user"] != null) {%>
                        <a href="search.aspx" class="icons"><img src="images/search.png" alt="Search"></a>
                        <a href="help.aspx" class="icons"><img src="images/question.png" alt="Help"></a>
                        <a href="about.aspx" class="icons"><img src="images/about.png" alt="About"></a>
                        <a href="logout.aspx" class="icons"><img src="images/logout.png" alt="log out"></a>
                    <%}%>
    
                    <%%>
                    <%if (Session["nihol"] != null && Session["nihol"].ToString() == "ok" && Session["user"] != null) {%>
                        <a href="addItem.aspx" class="icons"><img src="images/add.png" alt="addItem"></a>
                        <a href="menahel.aspx" class="icons"><img src="images/profile.png" alt="addItem"></a>
                    <%}%>
                </td>
            </tr>

            <tr>
                <td colspan="2" class="content" >
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </td>

            </tr>
            <tr><td> </td></tr>

        </table>
    </form>
</body>
</html>