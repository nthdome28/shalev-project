<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Shalev Website</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        body {
            font-family: sans-serif; /* Sets the text style */
            margin: 0; /* Removes outside spacing */
            background: #e8f0fe; /* Sets the background color */
            color: #1f1f1f; /* Sets the text color */
        }

        .title {
            font-size: 30px; /* Makes the text big */
            padding: 2px; /* Adds inside spacing */
            background: #4f8cff; /* Sets a blue background */
            color: white; /* Makes the text white */
        }

        .layout-table {
            width: 100%; /* Stretches the table across the whole screen */
            min-height: 800px; /* Makes sure it's at least this tall */
            background: lightblue; /* Fills the table with light blue */
            border: 5px solid #4f8cff; /* Adds a thick blue outline */
            border-collapse: collapse; /* Removes double lines between boxes */
        }

        .user-greeting {
            padding: 10px; /* Adds inside spacing */
            color: #4f8cff; /* Makes the text blue */
            text-align: right; /* Pushes the text to the right side */
            background: white; /* Sets a white background */
        }

        .menu {
            padding: 20px; /* Adds inside spacing */
            background: white; /* Sets a white background */
            border-bottom: 1px solid #e3e3e3; /* Draws a thin gray line at the bottom */
            text-align: center; /* Puts the menu items in the middle */
        }

        .icons {
            padding: 20px; /* Adds inside spacing */
            border-radius: 20px; /* Rounds the corners */
            transition: 0.2s; /* Makes the hover color change smoothly */

        }

        .icons:hover {
            background: #e8f0fe; /* Changes the background color when the mouse touches it */
        }

        .icons img {
            height: 30px; /* Sets the image height */
            width: 30px; /* Sets the image width */
            vertical-align: middle; /* Lines the image up straight with the text */
        }

        .content {
            padding: 15px; /* Adds inside spacing */
            background: white; /* Sets a white background */
            border-radius: 24px; /* Rounds the corners a lot */
            margin: 50px 40px; /* Centers the box on the screen */
        }

        .content h2 {
            color: #4f8cff; /* Makes header text blue */
        }
    </style>
</head>
<body>
    <form runat="server" method="post" onsubmit="return checkAll();">
        
        <% if ((Session["admin"] != null && Session["admin"].ToString() == "ok") || (Session["user"] != null && Session["user"].ToString() == "ok")) { %>
            <div class="user-greeting">
                Hello <%= Session["name"] %>
            </div>
        <% } %>

        <table class="layout-table">
            <tr>
                <td class="title">
                    Shalev Supermarket
                </td>
            </tr>
                                                                                                        
            <tr>
                <td class="menu">
                   <% if (Session["admin"] == null && Session["user"] == null) { %>
                    <a href="home.aspx" class="icons"><img src="images/home.png" alt="Home"></a>
                    <a href="signIn.aspx" class="icons"><img src="images/login.png" alt="Sign In"></a>
                    <a href="signUp.aspx" class="icons"><img src="images/signup.png" alt="Sign Up"></a>
                    <a href="gallary.aspx" class="icons"><img src="images/gallary.png" alt="Gallery"></a>
                       <% } %> 


                    <% if ((Session["admin"] != null && Session["admin"].ToString() == "ok") || (Session["user"] != null && Session["user"].ToString() == "ok")) { %>
                    <a href="home.aspx" class="icons"><img src="images/home.png" alt="Home"></a>    
                    <a href="search.aspx" class="icons"><img src="images/search.png" alt="Search"></a>
                    <a href="gallary.aspx" class="icons"><img src="images/gallary.png" alt="Gallery"></a>
                        <a href="help.aspx" class="icons"><img src="images/question.png" alt="Help"></a>
                        <a href="about.aspx" class="icons"><img src="images/about.png" alt="About"></a>
                        <a href="logout.aspx" class="icons"><img src="images/logout.png" alt="Log out"></a>
                    <% } %>
    
                    <% if (Session["admin"] != null && Session["admin"].ToString() == "ok") { %>
                        <a href="addItem.aspx" class="icons"><img src="images/add.png" alt="Add Item"></a>
                        <a href="menahel.aspx" class="icons"><img src="images/profile.png" alt="Manager"></a>
                    <% } %>
                </td>
            </tr>

            <tr>
                <td>
                    <div class="content">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </td>
            </tr>
        </table>
    </form>
</body>
</html>