<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>shalev website</title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>

   <style>
       .table_component {
           overflow: auto;
           width: 100%;
       }

       .table_component table {
           border: 0px solid black;
           height: 100%;
           width: 100%;
           table-layout: fixed;
           border-collapse: collapse;
           border-spacing: 2px;
           text-align: center;
       }

       .table_component  caption {
           caption-side:top;
           text-align: center;
       }

       .table_component th {
           border: 0px solid black;
           background-color: black;
           color: white;
           padding: 5px;
       }

       .table_component td {
           border: 0px solid #dededf;
           background-color: #969696;
           color: black;
           padding: 5px;
       }
   </style>
</head>
<body>
    <div class="table_component" role="region" tabindex="0"></div>
    <table>

        <thead>
            
            <tr>
            <th colspan="3">

                <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
                 </asp:ContentPlaceHolder></th>

            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a href ="home.aspx"><img src="" height="50" /></a></td>
                <td><a href ="help.aspx"><img src="" height="50"/></a></td>
                <td><a href ="forms.aspx"><img src="" height="50"/></a></td>
                <td><a href ="AspNet.aspx"><img src="" height="50"/></a></td>

            </tr>
        </tbody>
    </table>
    <div style="margin-top:8px"></div>
    </div>

        <div style="margin-top:40px; padding:20px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
        </div>
    
    
</body>
</html>
