<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage"  %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Shalev Website</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            padding: 0;
            text-decoration-color: #
        }

        .title {
            font-size: 28px;
            text-align: center;
            padding: 10px;
            background-color:#8D5A2B;
        }

        .menu  {
            margin: 5px;
            background-color:#F3E5AB;
        }

        img {
            width: 100px;
            height: 60px;
            margin: 5px;
            
        }

        .content {
            padding: 20px;
            background-color:#FDFBD4;
            align-content:baseline;
        }
    </style>
</head>

<body>
    <form runat="server">
        <table width="100%" height="800px" border="5px" background="lightblue" >

            <tr>
                <td  class="title" height="50px">
                    shalev website
                </td>
            </tr>

            <tr>
                <td colspan="2" align="center" class="menu" height="100px">
                    <a href="home.aspx"><img src="images/homepage.png" alt="Home"></a>
                    <a href="search.aspx"><img src="images/search.png" alt="Search"></a>
                    <a href="forms.aspx"><img src="images/forms.png"" alt="Forms"></a>
                    <a href="signIn.aspx"><img src="images/signin.png" alt="Sign In"></a>
                    <a href="signUp.aspx"><img src="images/signup.png" alt="Sign Up"></a>
                    <a href="help.aspx"><img src="images/help.png"" alt="Help"></a>
                    <a href="about.aspx"><img src="images/about.png" alt="About"></a>
                    <a href="exit.aspx"><img src="images/exit.png" alt="Exit"></a>
                    <a href="gorge.aspx"><img src="images/gorge.jpg" alt="gorge"></a>
                </td>
            </tr>

            <tr>
                <td colspan="2" class="content" >
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
            <tr><td> </td></tr>

        </table>
    </form>
</body>
</html>
