<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Shalev Supermarket</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    
    <style>
        /* Base Styles */
        body {
            font-family: Arial, sans-serif; /* Sets font */
            background-color: #f4f7f6; /* Page background color */
            color: #333; /* Text color */
        }

        /* Layout Structure */
        table {
            width: 100%; /* Full screen width */
        }

        /* Header / Title */
        .header {
            background-color: #0056b3; /* Header blue color */
            color: white; /* White text color */
            font-size: 26px; /* Text size */
            font-weight: bold; /* Bold text */
            padding: 20px; /* Space inside header */
        }

        /* Navigation Bar */
        .nav {
            background-color: #ffffff; /* White background color */
            padding: 30px; /* Space inside nav bar */
            text-align: center; /* Centers icons */
        }
        .nav img {
            width: 28px; /* Icon width */
            height: 28px; /* Icon height */
            margin: 15px;
        }

        /* Main Content Box */
        .content {
            background-color: #ffffff; /* White background color */
            padding: 30px; /* Space inside content box */
        }
        .content h2 {
            color: #0056b3; /* Blue heading color */
        }
    </style>
</head>

<body>
    <form runat="server" method="post" onsubmit="return checkAll();">
        
        <% if ((Session["admin"] != null && Session["admin"].ToString() == "ok") || (Session["user"] != null && Session["user"].ToString() == "ok")) { %>
            <div style="text-align: right; padding: 10px; font-weight: bold; color: #555;">
                Hello <%=Session["name"] %>
            </div>
        <% } %>

        <table>
            <tr>
                <td class="header">
                    Shalev Supermarket
                </td>
            </tr>
            
            <tr>
                <td class="nav">
                    <a href="home.aspx"><img src="images/home.png" alt="Home"></a>
                    <a href="signIn.aspx"><img src="images/login.png" alt="Sign In"></a>
                    <a href="signUp.aspx"><img src="images/signup.png" alt="Sign Up"></a>
                        
                    <% if ((Session["admin"] != null && Session["admin"].ToString() == "ok") || (Session["user"] != null && Session["user"].ToString() == "ok")) { %>
                        <a href="search.aspx"><img src="images/search.png" alt="Search"></a>
                        <a href="gallary.aspx"><img src="images/gallary.png" alt="Gallery"></a>
                        <a href="help.aspx"><img src="images/question.png" alt="Help"></a>
                        <a href="about.aspx"><img src="images/about.png" alt="About"></a>
                        <a href="logout.aspx"><img src="images/logout.png" alt="Log Out"></a>
                    <% } %>
    
                    <% if (Session["admin"] != null && Session["admin"].ToString() == "ok") { %>
                        <a href="addItem.aspx"><img src="images/add.png" alt="Add Item"></a>
                        <a href="menahel.aspx"><img src="images/profile.png" alt="Admin Profile"></a>
                    <% } %>
                </td>
            </tr>

            <tr>
                <td class="content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
        </table>
    </form>
</body>
</html>